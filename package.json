{
  "name": "jw3-dino-habitat-planner",
  "private": true,
  "version": "0.1.0",
  "description": "Recommends the best-matching liked creature by habitat similarity, using the JW3 Dino Habitat Planner workbook as the data source.",
  "type": "module",
  "scripts": {
    "data": "tsx scripts/generate-data.ts",
    "dev": "vite",
